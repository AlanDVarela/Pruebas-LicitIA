body{font:14px/1.55 -apple-system,"Helvetica Neue",Arial,sans-serif;color:#1d1d1f;max-width:900px;margin:32px auto;padding:0 24px;position:relative}
h1{font-size:22px;margin:0 0 4px} h2{font-size:15px;margin:28px 0 8px;border-bottom:1px solid #d2d2d7;padding-bottom:4px} h3{font-size:13px;margin:14px 0 4px}
.meta{color:#6e6e73;font-size:12px}
table{width:100%;border-collapse:collapse;font-size:13px} th,td{border:1px solid #d2d2d7;padding:6px 8px;text-align:left;vertical-align:top} th{background:#f5f5f7}
td.c{text-align:center;white-space:nowrap}
.marca{position:fixed;top:40%;left:0;right:0;text-align:center;font-size:110px;font-weight:700;color:rgba(0,0,0,.06);transform:rotate(-20deg);pointer-events:none}
.ia{background:#fff8e1;border-left:3px solid #ff9f0a;padding:8px 12px} .ia-tag{display:block;font-size:11px;font-weight:600;color:#b36b00}
.ok{color:#248a3d;font-weight:600} .no{color:#d70015;font-weight:600}
.evid{color:#6e6e73;font-size:12px;font-style:italic}
.firmas{display:flex;gap:24px;margin-top:56px} .firma{flex:1;border-top:1px solid #1d1d1f;padding-top:6px;text-align:center;font-size:12px}
.pie{margin-top:36px;font-size:11px;color:#6e6e73;border-top:1px solid #d2d2d7;padding-top:8px}
@media print{ .noprint{display:none} }
