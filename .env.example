# ── Copia este archivo a .env  (cp .env.example .env) ──────────────
# Valores SOLO para desarrollo local. Nunca reutilizar en producción.

# Postgres (imagen con pgvector)
POSTGRES_USER=licitaia
POSTGRES_PASSWORD=licitaia_dev
POSTGRES_DB=licitaia
POSTGRES_PORT=5433            # puerto expuesto en tu Mac (dentro de Docker siempre es 5432)

# Redis (cola de trabajos; se usará en el sprint de OCR)
REDIS_PORT=6380

# S3 simulado (adobe/s3mock) para propuestas de licitantes
S3_PORT=9090
S3_BUCKET=licitaia-docs
S3_REGION=us-east-1

# API
API_PORT=3100
NODE_ENV=development
JWT_SECRET=change-me-with-openssl-rand-hex-32
JWT_EXPIRES_IN=8h
COOKIE_SECURE=false           # true detrás de HTTPS
CORS_ORIGIN=http://localhost:5173
MFA_REQUIRED=false            # TOTP aún no implementado; ver docs/PLAN_MVP.md

# IA (mock por defecto: no sale ninguna llamada a internet)
AI_ENABLED=true
LLM_PROVIDER=mock             # mock | anthropic (anthropic pendiente de implementar)
ANTHROPIC_API_KEY=

# Datos semilla
SEED_PASSWORD=Licita2026!

# Web
WEB_PORT=5173

# Solo si corres la API fuera de Docker (npm run dev -w @licitaia/api):
DATABASE_URL=postgresql://licitaia:licitaia_dev@localhost:5433/licitaia
REDIS_URL=redis://localhost:6380
